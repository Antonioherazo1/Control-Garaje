PORT=3000
JWT_SECRET=cambia-esta-clave-por-una-segura-larga
JWT_EXPIRES=8h

# PIN inicial del usuario admin (solo se usa la primera vez que se arranca)
ADMIN_INITIAL_PIN=1234

# Broker MQTT del garaje (contenedor aislado, escucha local en 1884)
MQTT_URL=mqtt://127.0.0.1:1884
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PREFIX=garaje
MQTT_CLIENT_ID=garaje-server

# Separacion minima entre pulsos (ms) para evitar doble comando
MIN_PULSE_GAP_MS=1500

# Maximo de eventos guardados en el historial
MAX_HISTORY=2000
